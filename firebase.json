        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    },
    {
      "target": "web",
      "public": "web/.output-cs/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/partner-form",
          "function": {
            "functionId": "sendPartnerForm",
            "region": "europe-west3"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/_nuxt/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    }
  ],
  "firestore": [
    {
      "database": "odorik",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5005 },
    "ui": { "enabled": true, "port": 4041 }
  }
}
