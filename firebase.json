{
  "functions": [
    {
      "source": "functions",
      "codebase": "crm",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix functions/shared run build",
        "npm --prefix functions run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "frontend",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/callbacks/grok-auth",
          "function": {
            "functionId": "grokAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/callbacks/coding",
          "function": {
            "functionId": "codingCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/callbacks/coding-auth",
          "function": {
            "functionId": "codingAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/webhooks/github",
          "function": {
            "functionId": "githubWebhook",
            "region": "europe-west3"
          }
        },
        {
          "source": "/oauth/google/callback",
          "function": {
            "functionId": "googleOAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "europe-west3"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    },
    {
      "site": "odorik-tx-260720-c58d",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/callbacks/grok-auth",
          "function": {
            "functionId": "grokAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/callbacks/coding",
          "function": {
            "functionId": "codingCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/callbacks/coding-auth",
          "function": {
            "functionId": "codingAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/webhooks/github",
          "function": {
            "functionId": "githubWebhook",
            "region": "europe-west3"
          }
        },
        {
          "source": "/oauth/google/callback",
          "function": {
            "functionId": "googleOAuthCallback",
            "region": "europe-west3"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "europe-west3"
          }
        },
        {
          "source": "**",
