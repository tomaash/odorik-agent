{
  "functions": [
    {
      "source": "functions",
      "codebase": "crm",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/oauth/google/callback",
        "function": {
          "functionId": "googleOAuthCallback",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "europe-west3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "odorik",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5005 },
    "ui": { "enabled": true, "port": 4041 }
  }
}
