# Local frontend env. Prefer npm scripts over this file:
#   npm run dev / npm run dev:prod     → prod backend (no local secrets)
#   npm run dev:emulator               → Auth + API emulators

# true  → Auth + API against Firebase emulators
# false → Auth + API against production (default / preferred)
VITE_USE_FIREBASE_EMULATORS=false

# Optional overrides (normally leave unset):
# VITE_API_TARGET=https://agent-erik-app.web.app
# VITE_API_TARGET=http://127.0.0.1:5001/odorik-tx-260720-c58d/europe-west3
# VITE_API_URL=/api
# VITE_FIREBASE_AUTH_DOMAIN=odorik-tx-260720-c58d.web.app
