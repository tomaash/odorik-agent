{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "${MICROSOFT_TEAMS_APP_ID}",
  "developer": {
    "name": "Agent Erik",
    "websiteUrl": "${APP_ORIGIN}",
    "privacyUrl": "${PRIVACY_URL}",
    "termsOfUseUrl": "${TERMS_URL}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Agent Erik",
    "full": "Agent Erik for Microsoft Teams"
  },
  "description": {
    "short": "Private, permission-aware company assistant and approval surface.",
    "full": "Ask permission-aware company questions and review exact task or email-draft proposals in a personal conversation. Agent Erik does not read channels or shared chats."
  },
  "accentColor": "#047857",
  "bots": [
    {
      "botId": "${MICROSOFT_TEAMS_BOT_CLIENT_ID}",
      "scopes": ["personal"],
      "isNotificationOnly": false,
      "supportsFiles": false
    }
  ],
  "defaultInstallScope": "personal",
  "validDomains": ["${APP_HOSTNAME}"]
}
