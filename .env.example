GEMINI_API_KEY=
PROJECT_ID=
FIRESTORE_DATABASE_ID=odorik
RECORDINGS_BUCKET=
DASHBOARD_TOKEN=
ODORIK_UPLOAD_USER=
ODORIK_UPLOAD_PASSWORD=
# Base64-encoded random 32-byte AES key shared by the application API and
# recording ingest service. It encrypts per-connection credentials.
CONNECTOR_CREDENTIAL_KEY=
ODORIK_CONNECTION_ID=odorik-primary
ODORIK_INGEST_BASE_URL=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional. Without both values the factual agent uses its Firestore BM25 fallback.
QDRANT_URL=
# Local aliases such as QDRANT_CLUSTER_URL are accepted, but deployments bind QDRANT_URL.
QDRANT_API_KEY=
