GEMINI_API_KEY=
TRANSCRIPTION_PROVIDER=gemini
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Legacy rollback provider; still required by infra/deploy.sh.
DEEPGRAM_API_KEY=
PROJECT_ID=
FIRESTORE_DATABASE_ID=odorik
RECORDINGS_BUCKET=
DASHBOARD_TOKEN=
ODORIK_UPLOAD_USER=
ODORIK_UPLOAD_PASSWORD=
# Base64-encoded random 32-byte AES key shared by the application API and
# recording ingest service. It encrypts per-connection credentials.
CONNECTOR_CREDENTIAL_KEY=
# Microsoft Entra multi-tenant web app. Register /oauth/microsoft/callback as a
# web redirect URI and store production values in Secret Manager.
MICROSOFT_CONNECTOR_CLIENT_ID=
MICROSOFT_CONNECTOR_CLIENT_SECRET=
MICROSOFT_TEAMS_APP_ID=
MICROSOFT_TEAMS_BOT_CLIENT_ID=
MICROSOFT_TEAMS_BOT_CLIENT_SECRET=
MICROSOFT_TEAMS_BOT_TENANT_ID=
ODORIK_CONNECTION_ID=odorik-primary
ODORIK_INGEST_BASE_URL=
GEMINI_MODEL=gemini-3.1-flash-lite
# Required for factual search. Without both values, company search is unavailable.
QDRANT_URL=
# Local aliases such as QDRANT_CLUSTER_URL are accepted, but deployments bind QDRANT_URL.
QDRANT_API_KEY=
# Team invitation email. Store the production value in Secret Manager.
RESEND_API_KEY=
APP_ORIGIN=https://odorik-tx-260720-c58d.web.app
# Slack app used for notifications, direct conversation, and Block Kit task
# approval. Store production
# values in Secret Manager. The bot token is a single-workspace development
# shortcut; installed workspaces carry their own per-connection credential.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
